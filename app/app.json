{
  "expo": {
    "name": "SAICS",
    "slug": "saics",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E8452A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.saics.app"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "./plugins/withShortCxxPath",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/ShipporiMincho-ExtraBold.ttf",
            "./assets/fonts/ArchivoNarrow-Regular.ttf",
            "./assets/fonts/ArchivoNarrow-SemiBold.ttf",
            "./assets/fonts/ArchivoNarrow-Bold.ttf",
            "./assets/fonts/IBMPlexMono-Regular.ttf"
          ]
        }
      ]
    ],
    "scheme": "saics",
    "backgroundColor": "#0E0C0A"
  }
}
